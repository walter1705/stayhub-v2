# StayHub v2 (backend) - .env example
#
# Spring Boot reads these through `src/main/resources/application.properties`.
# The dependency `me.paulschwarz:spring-dotenv` loads `.env` into Spring's Environment.
#
# Copy to `.env` and adjust values for your machine.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/stayhub_v2
DB_USERNAME=postgres

# Sensitive
DB_PASSWORD=postgres

# Optional (dev)
JPA_DDL_AUTO=update

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
# Sensitive (must be >= 32 chars)
JWT_SECRET_KEY=change-me-change-me-change-me-change-me

# Optional default is 24h
JWT_TIME_EXPIRATION=86400000

# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
# Defaults in app properties point to localhost:1025.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=stayhub@example.test

# Sensitive
MAIL_PASSWORD=stayhub

# For local SMTP catchers (Mailpit/MailHog) usually false/false.
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false

# -----------------------------------------------------------------------------
# StayHub business config (Payments)
# -----------------------------------------------------------------------------
# Required in code. App has a dummy default, but set a real one for prod.
STAYHUB_PAYMENT_BANK_ACCOUNT=3001234567890

# Optional
STAYHUB_PAYMENT_DEPOSIT_PERCENTAGE=20
STAYHUB_PAYMENT_DEADLINE_DAYS=3
